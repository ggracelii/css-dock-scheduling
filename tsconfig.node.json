{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["vite.config.ts", "scripts/**/*.ts", "tests/**/*.ts", "src/types/**/*.ts", "src/lib/**/*.ts"]
}
